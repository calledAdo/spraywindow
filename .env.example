# Copy to .env and fill in. Never commit .env.
SAMPLE_MODE=false

# Zetaris (local Docker install)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Setup only; runtime agents never use this administrator key.
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift runtime (from Nightshift > Console)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_APP_ID=spraywindow
METERLESS_FAST_MODE=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_DEEP_MODE=nvidia/nemotron-3-ultra-550b-a55b

# Farm database (uses existing Lotline Postgres container)
FARM_DB_USER=spraywindow
FARM_DB_PASSWORD=change-me

# Weather location (Central Valley, CA)
WEATHER_LAT=36.7783
WEATHER_LON=-119.4179
WEATHER_TZ=America/Los_Angeles
FORECAST_ID=fcst-2026-10-25

# Object storage (uses existing Lotline SeaweedFS bucket `lotline`)
S3_ACCESS_KEY=your-local-s3-access-key
S3_SECRET_KEY=change-me-too
S3_ENDPOINT=http://localhost:9000

# npm run setup:zetaris generates local test credentials for missing placeholders.
# Runtime: Basic login -> in-memory idToken, or an optional per-user API_KEY.
ZETARIS_RULES_CHECKER_USER=your-rules-checker-user
ZETARIS_RULES_CHECKER_PASSWORD=your-rules-checker-password
# ZETARIS_RULES_CHECKER_API_KEY=your-rules-checker-api-key
ZETARIS_WEATHER_ANALYST_USER=your-weather-analyst-user
ZETARIS_WEATHER_ANALYST_PASSWORD=your-weather-analyst-password
# ZETARIS_WEATHER_ANALYST_API_KEY=your-weather-analyst-api-key
ZETARIS_MEMORY_KEEPER_USER=your-memory-keeper-user
ZETARIS_MEMORY_KEEPER_PASSWORD=your-memory-keeper-password
# ZETARIS_MEMORY_KEEPER_API_KEY=your-memory-keeper-api-key
ZETARIS_PLANNER_USER=your-planner-user
ZETARIS_PLANNER_PASSWORD=your-planner-password
# ZETARIS_PLANNER_API_KEY=your-planner-api-key
ZETARIS_CRITIC_USER=your-critic-user
ZETARIS_CRITIC_PASSWORD=your-critic-password
# ZETARIS_CRITIC_API_KEY=your-critic-api-key
# Model request time limits in ms (Ultra with reasoning needs minutes on a full plan).
LLM_TIMEOUT_MS_FAST=180000
LLM_TIMEOUT_MS_DEEP=480000

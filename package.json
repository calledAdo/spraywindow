{
  "name": "spray-window",
  "version": "0.1.0",
  "private": true,
  "description": "Spray Window: a 48-hour field-operations decision agent over Zetaris, H-MEM and Meterless Nightshift + NVIDIA Nemotron.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "engine:conformance": "HMEM_IMPL=$PWD/engines/hmem/reference/src/index.ts tsx engines/hmem/conformance/runner.ts",
    "data:seed": "tsx --env-file-if-exists=.env scripts/seed-farm.ts",
    "data:weather": "tsx scripts/fetch-weather.ts",
    "data:upload": "tsx scripts/upload-objects.ts",
    "setup:zetaris": "tsx scripts/setup-zetaris.ts",
    "record:cassettes": "tsx scripts/record-cassettes.ts",
    "spray": "tsx src/cli.ts",
    "demo": "SAMPLE_MODE=true bash scripts/demo.sh"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.913.0",
    "@duckdb/node-api": "^1.4.5-r.1",
    "pg": "^8.16.3"
  }
}
